{
    "name": "taggr",
    "version": "0.1.0",
    "description": "Decentralized Social Network",
    "imports": {
        "#markdown": "./src/frontend/src/markdown.ts"
    },
    "keywords": [
        "TypeScript",
        "Canister"
    ],
    "scripts": {
        "build": "webpack",
        "postbuild": "find dist/frontend -name '*.js' -exec gzip -9n {} +",
        "start": "webpack serve --mode development --env development",
        "test:e2e": "playwright test",
        "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/frontend/src/*.test.ts",
        "install:e2e": "playwright install chromium --with-deps",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@playwright/test": "1.56.1",
        "@types/isomorphic-fetch": "0.0.39",
        "@types/react-dom": "19.0.0",
        "buffer": "6.0.3",
        "copy-webpack-plugin": "^14.0.0",
        "html-webpack-plugin": "5.5.3",
        "isomorphic-fetch": "3.0.0",
        "prettier": "^3.3.3",
        "process": "0.11.10",
        "raw-loader": "4.0.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "terser-webpack-plugin": "^5.3.10",
        "esbuild-loader": "4.5.0",
        "typescript": "7.0.2",
        "webpack": "^5.111.1",
        "webpack-cli": "7.2.3",
        "webpack-dev-server": "^6.0.0"
    },
    "browserslist": [
        "last 2 chrome version",
        "last 2 firefox version",
        "last 2 safari version",
        "last 2 edge version"
    ],
    "dependencies": {
        "@dfinity/utils": "5.0.0",
        "@icp-sdk/auth": "10.0.2",
        "@icp-sdk/canisters": "4.0.0",
        "@icp-sdk/core": "6.1.1",
        "diff-match-patch": "1.0.5"
    }
}
